# In development, leave this unset: Vite proxies /api to http://localhost:3001.
# For deployment, point this at the gateway origin (include /api), e.g. https://gateway.example.com/api
VITE_API_BASE_URL=

# Gateway origin for proxied microservice routes such as /flightsService.
# Leave unset in development; Vite proxies the route to localhost:3001.
VITE_GATEWAY_BASE_URL=
